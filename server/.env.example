# --- Required ---

# MongoDB Atlas connection string.
# Example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/sharebase?retryWrites=true&w=majority
ATLAS_URI=

# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Optional ---

# Port the API listens on.
PORT=5050

# Origin allowed by CORS. Comma-separated list, or "*" to allow all.
# Used by the Vite client.
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (image uploads). All three must be set together, or all
# left blank — a partial config is treated as a startup error. When
# left blank, /api/posts upload routes return 503 "Cloudinary is not
# configured" instead of crashing on a missing API key.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sharebase

# Per-image upload size cap (bytes). Default 5 MB.
MAX_UPLOAD_BYTES=5242880

# Pagination defaults for the posts feed/explore endpoints.
POSTS_PAGE_DEFAULT=12
POSTS_PAGE_MAX=50

# Node environment: development | production | test
NODE_ENV=development
