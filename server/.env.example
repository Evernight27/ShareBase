# --- Required ---

# MongoDB Atlas connection string.
# Example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/sharebase?retryWrites=true&w=majority
ATLAS_URI=

# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Optional ---

# Port the API listens on.
PORT=5050

# Origin allowed by CORS. Used by the Vite client added in Phase 5.
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (image uploads). If left blank the server falls back to local
# disk storage in server/uploads/ for development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Node environment: development | production | test
NODE_ENV=development
